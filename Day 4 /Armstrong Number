#include<iostream>
#include<cmath>
using namespace std;
int main() {
    int sum=0, N, digit, original, numDigits=0;
    cout << "N is the number you want to check its Armstrong or not" << endl;
    cout << "Enter N: ";
    cin >> N;
    original = N;
    int temp = N;
    while(temp > 0) {
    numDigits++;
    temp /= 10;
    }
    temp = N;
    while(temp > 0) {
        digit = temp % 10;
        sum += pow(digit, numDigits);
        temp /= 10;
    if(sum==original) {
      cout << original << " is an Armstrong Number" << endl;
    }
    else {
        cout << original << " is NOT an Armstrong Number";
    }
    return 0;
}
