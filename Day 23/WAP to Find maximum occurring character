#include <iostream>
using namespace std;
int main() {
    string s;
    cout << "Enter a string: ";
    getline(cin, s);
    int freq[256] = {0};
    for (int i = 0; i < s.length(); i++) {
        freq[(int)s[i]]++;
    }
    int maxCount = 0;
    char maxChar;
    for (int i = 0; i < s.length(); i++) {
        if (freq[(int)s[i]] > maxCount) {
            maxCount = freq[(int)s[i]];
            maxChar = s[i];
        }
    }
    cout << "Maximum occurring character: " << maxChar << endl;
    cout << "Frequency: " << maxCount << endl;
    return 0;
}
