#include <iostream>
#include <string>
using namespace std;
int main() {
    string s;
    cout << "Enter string: ";
    cin >> s;
    bool visited[256] = {false}; // track ASCII characters
    string result = "";
    for (int i = 0; i < s.length(); i++) {
        char ch = s[i];
        if (!visited[ch]) {
            result += ch;
            visited[ch] = true;
        }
    }
    cout << "String after removing duplicates: " << result << endl;
    return 0;
}
