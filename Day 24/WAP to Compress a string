#include <iostream>
#include <string>
using namespace std;
int main() {
    string s;
    cout << "Enter string: ";
    cin >> s;
    string compressed = "";
    int n = s.length();
    int i = 0;
    while (i < n) {
        char ch = s[i];
        int count = 1;
        while (i + 1 < n && s[i + 1] == ch) {
            count++;
            i++;
        }
        compressed += ch;
        if (count > 1) {
            compressed += to_string(count);
        }
        i++;
    }
    cout << "Compressed string: " << compressed << endl;
    return 0;
}
