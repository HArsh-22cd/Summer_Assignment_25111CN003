#include<iostream>
using namespace std;
int main() {
    int N, arr[32], i=0;
    cout << "N is the Decimal Number you want to convert in Binary" << endl;
    cout << "Enter N: ";
    cin >> N;
    while(N>0) {
      arr[i] = N%2;
      i++;
      N = N/2;
    }
    cout << "Binary: ";
    for(int j = i-1; j >= 0; j--) {
        cout << arr[j];
    }
    return 0;
}
