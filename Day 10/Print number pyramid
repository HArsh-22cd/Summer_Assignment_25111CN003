#include<iostream>
using namespace std;
int main() {
    int i, j, N;
    cout << "N is the number of rows you want in the Pyramid\n";
    cout << "Enter N: ";
    cin >> N;
    for(i=1; i<=N; i++) {
       for(j=1; j<=N-i; j++) {
           cout << " ";
        } 
         for(j = 1; j <= i; j++) {
            cout << j;
        }
        for(j = i - 1; j >= 1; j--) {
            cout << j;
        }
        cout << endl;
    }
    return 0;
}
