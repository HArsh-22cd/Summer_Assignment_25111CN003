#include<iostream>
using namespace std;
int factorial(int N) {
    if(N==0) {
       return 1;
    }
       return N*factorial(N-1);
}
    int main() {
        int N;
        cout << "N is the number you want Factorial of" << endl;
        cout << "Enter N: ";
        cin >> N;
        cout << "Factorial of " << N << " is " << factorial(N);
        return 0;
    }
