#include<iostream>
using namespace std;
int fibonacci(int N) {
    if(N==0) 
    return 0;
    if(N==1) 
    return 1;
    return fibonacci(N-1) + fibonacci(N-2);
}
int main() {
    int N;
    cout << "N is the number of terms you want in Fibonacci Series" << endl;
    cout << "Enter N: ";
    cin >> N;
    for(int i = 0; i < N; i++) {
       cout << fibonacci(i) << " ";
    }
}
