#include<iostream>
using namespace std;
int sum(int N) {
    if(N==0) {
       return 0;
    }
       return (N%10) + sum(N/10);
}
int main() {
    int N;
    cout << "N is the Number whose digit you want to add" << endl;
    cout << "Enter N: ";
    cin >> N;
    cout << "Sum of the digits = " << sum(N); 
    return 0;
}
