#include <iostream>
using namespace std;
int main() {
    int N;
    cout << "Enter size : ";
    cin >> N;
    int A[N][N], B[N][N];

    cout << "Enter Matrix A :" << endl;
    for (int i = 0; i < N; i++)
        for (int j = 0; j < N; j++)
            cin >> A[i][j];

    cout << "Enter Matrix B :" << endl;
    for (int i = 0; i < N; i++)
        for (int j = 0; j < N; j++)
            cin >> B[i][j];

    cout << "Subtraction :" << endl;
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++)
            cout << A[i][j] - B[i][j] << " ";
        cout << endl;
    }
    return 0;
}
