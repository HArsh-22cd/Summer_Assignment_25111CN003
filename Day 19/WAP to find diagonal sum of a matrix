#include <iostream>
using namespace std;
int main() {
    int N;
    cout << "Enter size : ";
    cin >> N;
    int A[N][N];

    cout << "Enter Matrix A :" << endl;
    for (int i = 0; i < N; i++)
        for (int j = 0; j < N; j++)
            cin >> A[i][j];

    int diagSum = 0;
    for (int i = 0; i < N; i++)
        diagSum += A[i][i];

    cout << "Diagonal Sum : " << diagSum << endl;
    return 0;
}
