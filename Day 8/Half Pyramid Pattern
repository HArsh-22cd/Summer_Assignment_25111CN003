#include<iostream>
using namespace std;
int main() {
    int i, j, N;
    cout << "N is the number of Row you want in the Pyramid" << endl;
    cout << "Enter N: ";
    cin >> N;
    for(i=1; i<=N; i++) {
        for(j=0; j<N-i; j++) {
            cout << " ";
        }
        for(j=0; j<2*i-1; j++) {
            cout << "*";
        }
        cout << endl;
    }
    return 0;
}
