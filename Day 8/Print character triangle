#include<iostream>
using namespace std;
int main() {
    int i, N;
    char j;
    cout << "N is the number of Row you want in the Pattern" << endl;
    cout << "Enter N: ";
    cin >> N;
    for(i=1; i<=N; i++) {
        for(j='A'; j<'A'+i; j++) {
            cout << j;
        }
        cout << endl;
    }
    return 0;
}
