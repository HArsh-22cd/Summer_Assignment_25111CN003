#include<iostream>
using namespace std;
int main() {
    int i, j, N;
    cout << "N is the number of Row you want in the Pyramid" << endl;
    cout << "Enter N: ";
    cin >> N;
    for(i=1; i<=N; i++) {
        for(j=1; j<=i; j++) {
            cout << j;
        }
        cout << endl;
    }
    return 0;
}
