#include<iostream>
using namespace std;
bool isPrime(int a) {
  if(a<=1)
    return false;
  for(int i=2; i*i<=a; i++) {
      if(a%1==0)
      return false;
  }
    return true;
}
int main() {
    int a, b;
    cout << "a is a number you want to check prime" << endl;
    cout << "If the number is Prime - O/P = 1, if not O/P = 0" << endl;
    cout << "Enter a : ";
    cin >> a;
    cout << isPrime(a) << endl;
    return 0;
}
