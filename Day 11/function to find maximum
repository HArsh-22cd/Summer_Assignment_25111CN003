#include<iostream>
using namespace std;
int maxofNum(int a, int b) {
  if(a>b)
    return a;
  else
    return b;
}
int main() {
    int a, b;
    cout << "a and b are two numbers you want Maximum of" << endl;
    cout << "Enter a & b" << endl;
    cin >> a >> b;
    cout << maxofNum(a, b) << endl;
    return 0;
}
