#include <iostream>
#include <string>
using namespace std;

class Student {
public:
    int rollNo;
    string name;
    int marks[5];      // marks for 5 subjects
    float percentage;

    void setData(int r, string n, int m[5]) {
        rollNo = r;
        name = n;
        int total = 0;
        for (int i = 0; i < 5; i++) {
            marks[i] = m[i];
            total += m[i];
        }
        percentage = total / 5.0;
    }

    char getGrade() {
        if (percentage >= 90) return 'A';
        else if (percentage >= 75) return 'B';
        else if (percentage >= 60) return 'C';
        else if (percentage >= 40) return 'D';
        else return 'F';
    }

    void display() {
        cout << rollNo << "\t" << name << "\t\t";
        for (int i = 0; i < 5; i++)
            cout << marks[i] << " ";
        cout << "\t" << percentage << "%\t" << getGrade() << endl;
    }
};

class StudentManager {
private:
    Student students[100];
    int count;

public:
    StudentManager() {
        count = 0;
    }

    int findStudentIndex(int rollNo) {
        for (int i = 0; i < count; i++) {
            if (students[i].rollNo == rollNo)
                return i;
        }
        return -1;
    }

    void addStudent() {
        if (count >= 100) {
            cout << "Records full!\n";
            return;
        }

        int roll, marks[5];
        string name;

        cout << "Enter Roll No: ";
        cin >> roll;

        if (findStudentIndex(roll) != -1) {
            cout << "Student with this Roll No already exists!\n";
            return;
        }

        cout << "Enter Name: ";
        cin >> name;

        cout << "Enter marks for 5 subjects: ";
        for (int i = 0; i < 5; i++)
            cin >> marks[i];

        students[count].setData(roll, name, marks);
        count++;
        cout << "Student record added successfully!\n";
    }

    void displayAll() {
        if (count == 0) {
            cout << "No records found!\n";
            return;
        }
        cout << "\nRoll\tName\t\tMarks\t\t\tPercentage\tGrade\n";
        cout << "-------------------------------------------------------------\n";
        for (int i = 0; i < count; i++)
            students[i].display();
    }

    void searchStudent() {
        int roll;
        cout << "Enter Roll No to search: ";
        cin >> roll;

        int idx = findStudentIndex(roll);
        if (idx == -1) {
            cout << "Student not found!\n";
            return;
        }
        cout << "\nRoll\tName\t\tMarks\t\t\tPercentage\tGrade\n";
        students[idx].display();
    }

    void updateStudent() {
        int roll;
        cout << "Enter Roll No to update: ";
        cin >> roll;

        int idx = findStudentIndex(roll);
        if (idx == -1) {
            cout << "Student not found!\n";
            return;
        }

        int marks[5];
        cout << "Enter new marks for 5 subjects: ";
        for (int i = 0; i < 5; i++)
            cin >> marks[i];

        students[idx].setData(students[idx].rollNo, students[idx].name, marks);
        cout << "Record updated successfully!\n";
    }

    void deleteStudent() {
        int roll;
        cout << "Enter Roll No to delete: ";
        cin >> roll;

        int idx = findStudentIndex(roll);
        if (idx == -1) {
            cout << "Student not found!\n";
            return;
        }

        for (int i = idx; i < count - 1; i++)
            students[i] = students[i + 1];

        count--;
        cout << "Record deleted successfully!\n";
    }

    void topperStudent() {
        if (count == 0) {
            cout << "No records found!\n";
            return;
        }

        int topIdx = 0;
        for (int i = 1; i < count; i++) {
            if (students[i].percentage > students[topIdx].percentage)
                topIdx = i;
        }

        cout << "\nTopper:\n";
        cout << "Roll\tName\t\tMarks\t\t\tPercentage\tGrade\n";
        students[topIdx].display();
    }

    void sortByPercentage() {
        if (count == 0) {
            cout << "No records found!\n";
            return;
        }

        for (int i = 0; i < count - 1; i++) {
            for (int j = 0; j < count - i - 1; j++) {
                if (students[j].percentage < students[j + 1].percentage) {
                    Student temp = students[j];
                    students[j] = students[j + 1];
                    students[j + 1] = temp;
                }
            }
        }
        cout << "Students sorted by percentage (descending)!\n";
    }
};

int main() {
    StudentManager mgr;
    int choice;

    do {
        cout << "\n----- STUDENT RECORD SYSTEM -----\n";
        cout << "1. Add Student\n";
        cout << "2. Display All Students\n";
        cout << "3. Search Student\n";
        cout << "4. Update Student\n";
        cout << "5. Delete Student\n";
        cout << "6. Show Topper\n";
        cout << "7. Sort by Percentage\n";
        cout << "0. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1: mgr.addStudent(); break;
            case 2: mgr.displayAll(); break;
            case 3: mgr.searchStudent(); break;
            case 4: mgr.updateStudent(); break;
            case 5: mgr.deleteStudent(); break;
            case 6: mgr.topperStudent(); break;
            case 7: mgr.sortByPercentage(); break;
            case 0: cout << "Exiting program. Bye!\n"; break;
            default: cout << "Invalid choice! Try again.\n";
        }

    } while (choice != 0);

    return 0;
}
