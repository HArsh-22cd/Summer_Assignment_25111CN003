#include <iostream>
using namespace std;
int main() {
    int N, i, j;
    cout << "Enter N : ";
    cin >> N;
    int arr[N];
    cout << "Enter elements : " << endl;
    for (i = 0; i < N; i++) {
        cin >> arr[i];
    }
    for (i = 0; i < N - 1; i++) {
        for (j = 0; j < N - i - 1; j++) {
            if (arr[j] < arr[j + 1]) {  // < instead of >
                swap(arr[j], arr[j + 1]);
            }
        }
    }
    cout << "Sorted Array in descending order: ";
    for (i = 0; i < N; i++) {
        cout << arr[i] << " ";
    }
    return 0;
}
