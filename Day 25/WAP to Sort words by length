#include <iostream>
#include <string>
using namespace std;
int main() {
    int n;
    cout << "Enter number of words: ";
    cin >> n;
    string words[n];
    cout << "Enter " << n << " words: " << endl;
    for (int i = 0; i < n; i++) {
        cin >> words[i];
    }
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - 1 - i; j++) {
            if (words[j].length() > words[j + 1].length()) {
                swap(words[j], words[j + 1]);
            }
        }
    }
    cout << "Words sorted by length: " << endl;
    for (int i = 0; i < n; i++) {
        cout << words[i] << endl;
    }
    return 0;
}
