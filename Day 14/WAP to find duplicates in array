#include<iostream>
using namespace std;
int main () {
      int N, i;
    cout << "N is the number of elements in Array" << endl;
    cout << "Enter N : ";
    cin >> N;
    int arr[N];
    cout << "Enter each elements of the Array : " << endl;;
    for(i=0; i<N; i++) {
       cin >> arr[i];
    }
    cout << "OUTPUT : "; 
    for(i=0; i<N; i++) {
       cout << arr[i] << " ";
    }
    cout << endl;
    int freq[1000] = {0};
    cout << "Duplicate Element: ";
    bool found = false;
    for (int i = 0; i<N; i++) {
        freq[arr[i]]++;
        if (freq[arr[i]] == 2) {
            cout << arr[i] << " ";
            found = true;
        }
    }
    if (!found)
        cout << "No duplicates found.";
    cout << endl;
    return 0;
}
