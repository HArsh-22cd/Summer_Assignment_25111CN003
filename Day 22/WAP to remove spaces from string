#include <iostream>
using namespace std;
int main() {
    string str;
    cout << "Enter a string: ";
    getline(cin, str);
    int n = str.length();
    string result = "";
    for (int i = 0; i < n; i++) {
        if (str[i] != ' ') {
            result += str[i];
        }
    }
    cout << "String without spaces: " << result << endl;
    return 0;
}
