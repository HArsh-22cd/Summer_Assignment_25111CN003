#include <iostream>
using namespace std;
int main() {
    string str;
    cout << "Enter a string: ";
    cin >> str;
    int n = str.length();
    int freq[256] = {0};
    for (int i = 0; i < n; i++) {
        freq[str[i]]++;
    }
    bool found = false;
    for (int i = 0; i < n; i++) {
        if (freq[str[i]] > 1) {
            cout << "First repeating character: " << str[i] << endl;
            found = true;
            break;
        }
    }
    if (!found)
        cout << "No repeating character found." << endl;

    return 0;
}
