#include<iostream>
using namespace std;
bool isPalindrome(int a) {
  int num, rev=0, digit;
  num = a;
  while(a > 0) {
  digit = a % 10;
  rev = rev * 10 + digit;
  a /= 10;
  }
  if(rev == num)
    return true;
  else
    return false;
}
int main() {
    int a;
    cout << "a is a number you want to check is Palindrome or not" << endl;
    cout << "Enter a : ";
    cin >> a;
    cout << isPalindrome(a) << endl;
    return 0;
}
