#include<iostream>
#include<cmath>
using namespace std;
bool isArmstrong(int a) {
  int org, numDigit=0, digit, sum=0;
  org = a;
  int temp = a;
  while(temp > 0) {
  numDigit++;
  temp /= 10;
  }
  temp = a;
  while(temp > 0) {
    digit = temp % 10;
    sum += pow(digit, numDigit);
    temp /= 10;
  }
  if(sum == org)
    return true;
  else
    return false;
}
int main() {
    int a;
    cout << "a is a number you want to check is Armstrong or not" << endl;
    cout << "Enter a : ";
    cin >> a;
    cout << isArmstrong(a) << endl;
    return 0;
}
