#include<iostream>
using namespace std;
bool isPerfect(int a) {
  int sum=0;
  for(int i=1; i<a/2; i++) {
  if(a%i == 0)
  sum += i;
  }
  if(sum == a)
    return true;
  else
    return false;
}
int main() {
    int a;
    cout << "a is a number you want to check is Perfect or not" << endl;
    cout << "Enter a : ";
    cin >> a;
    cout << isPerfect(a) << endl;
    return 0;
}
