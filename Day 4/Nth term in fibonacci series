#include<iostream>
using namespace std;
int main() {
    int a = 0, b = 1, i, N, c;
    cout << "Nth is the term you want from the Fibonacci Series" << endl;
    cout << "Enter N: ";
    cin >> N;
    for(i=0; i<N-1; i++)  {
        c = a + b;
        a = b;
        b = c;
    }
    cout << N << "th term in the series is " << a << endl;
    return 0;
}
