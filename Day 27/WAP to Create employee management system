#include <iostream>
#include <string>
using namespace std;
const int MAX_EMPLOYEES = 100;
struct Employee {
    int id;
    string name;
    string department;
    float salary;
};
Employee employees[MAX_EMPLOYEES];
int employeeCount = 0;
void addEmployee() {
    if (employeeCount >= MAX_EMPLOYEES) {
        cout << "Employee list is full!\n";
        return;
    }
    Employee e;
    cout << "Enter Employee ID: ";
    cin >> e.id;
    cout << "Enter Name: ";
    cin.ignore();
    getline(cin, e.name);
    cout << "Enter Department: ";
    getline(cin, e.department);
    cout << "Enter Salary: ";
    cin >> e.salary;

    employees[employeeCount] = e;
    employeeCount++;
    cout << "Employee record added successfully!\n";
}
int findEmployeeIndex(int id) {
    for (int i = 0; i < employeeCount; i++) {
        if (employees[i].id == id)
            return i;
    }
    return -1;
}
void displayAll() {
    if (employeeCount == 0) {
        cout << "No records found.\n";
        return;
    }
    cout << "\n--- All Employee Records ---\n";
    cout << "ID\tName\t\tDepartment\tSalary\n";
    for (int i = 0; i < employeeCount; i++) {
        cout << employees[i].id << "\t" << employees[i].name << "\t\t"
             << employees[i].department << "\t\t" << employees[i].salary << "\n";
    }
}
void searchEmployee() {
    int id;
    cout << "Enter Employee ID to search: ";
    cin >> id;
    int idx = findEmployeeIndex(id);
    if (idx == -1) {
        cout << "Employee not found!\n";
    } else {
        cout << "ID: " << employees[idx].id << ", Name: " << employees[idx].name
             << ", Department: " << employees[idx].department
             << ", Salary: " << employees[idx].salary << "\n";
    }
}
void updateEmployee() {
    int id;
    cout << "Enter Employee ID to update: ";
    cin >> id;
    int idx = findEmployeeIndex(id);
    if (idx == -1) {
        cout << "Employee not found!\n";
        return;
    }
    cout << "Enter new Name: ";
    cin.ignore();
    getline(cin, employees[idx].name);
    cout << "Enter new Department: ";
    getline(cin, employees[idx].department);
    cout << "Enter new Salary: ";
    cin >> employees[idx].salary;
    cout << "Record updated successfully!\n";
}
void deleteEmployee() {
    int id;
    cout << "Enter Employee ID to delete: ";
    cin >> id;
    int idx = findEmployeeIndex(id);
    if (idx == -1) {
        cout << "Employee not found!\n";
        return;
    }
    for (int i = idx; i < employeeCount - 1; i++) {
        employees[i] = employees[i + 1];
    }
    employeeCount--;
    cout << "Record deleted successfully!\n";
}
void menu() {
    cout << "\n===== Employee Management System =====\n";
    cout << "1. Add Employee\n";
    cout << "2. Display All Employees\n";
    cout << "3. Search Employee by ID\n";
    cout << "4. Update Employee\n";
    cout << "5. Delete Employee\n";
    cout << "6. Exit\n";
    cout << "Enter your choice: ";
}
int main() {
    int choice;
    do {
        menu();
        cin >> choice;
        switch (choice) {
            case 1: addEmployee(); break;
            case 2: displayAll(); break;
            case 3: searchEmployee(); break;
            case 4: updateEmployee(); break;
            case 5: deleteEmployee(); break;
            case 6: cout << "Exiting program...\n"; break;
            default: cout << "Invalid choice! Try again.\n";
        }
    } while (choice != 6);
    return 0;
}
