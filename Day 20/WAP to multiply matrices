#include <iostream>
using namespace std;
int main() {
    int r1, c1, r2, c2;
    cout << "Enter rows of first matrix: ";
    cin >> r1;
    cout << "Enter columns of first matrix: ";
    cin >> c1;
    cout << "Enter rows second matrix: ";
    cin >> r2;
    cout << "Enter columns second matrix: ";
    cin >> c2;
    if (c1 != r2) {
        cout << "Matrix multiplication not possible! (columns of A must equal rows of B)" << endl;
        return 0;
    }
    int A[r1][c1], B[r2][c2], C[r1][c2];
    cout << "Enter elements of first matrix (" << r1 << "x" << c1 << "):" << endl;
    for (int i = 0; i < r1; i++)
        for (int j = 0; j < c1; j++)
            cin >> A[i][j];
    cout << "Enter elements of second matrix (" << r2 << "x" << c2 << "):" << endl;
    for (int i = 0; i < r2; i++)
        for (int j = 0; j < c2; j++)
            cin >> B[i][j];
    for (int i = 0; i < r1; i++)
        for (int j = 0; j < c2; j++)
            C[i][j] = 0;
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            for (int k = 0; k < c1; k++) {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }
    cout << "\nResultant Matrix (" << r1 << "x" << c2 << "):" << endl;
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++)
            cout << C[i][j] << " ";
        cout << endl;
    }
    return 0;
}
