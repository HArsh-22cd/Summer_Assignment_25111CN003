#include<iostream>
using namespace std;
int main () {
      int N, i, j=0;
    cout << "N is the number of elements in Array" << endl;
    cout << "Enter N : ";
    cin >> N;
    int arr[N];
    cout << "Enter each elements of the Array : " << endl;;
    for(i=0; i<N; i++) {
       cin >> arr[i];
    }
    cout << "OUTPUT : "; 
    for(i=0; i<N; i++) {
       cout << arr[i] << " ";
    }
    cout << endl;
    for (int i=0; i<N; i++) {
    if(arr[i]!=0) {
        arr[j] = arr[i];
        j++;
    }
    }
    for(j=j; j<N; j++) {
       arr[j]=0;
    }
    cout << "The new array is : ";
    for(i=0; i<N; i++) {
       cout << arr[i] << " ";
    }
    return 0;
}
