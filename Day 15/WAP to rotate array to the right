#include<iostream>
using namespace std;
int main () {
      int N, i, K;
    cout << "N is the number of elements in Array" << endl;
    cout << "Enter N : ";
    cin >> N;
    int arr[N];
    cout << "Enter each elements of the Array : " << endl;;
    for(i=0; i<N; i++) {
       cin >> arr[i];
    }
    cout << "OUTPUT : "; 
    for(i=0; i<N; i++) {
       cout << arr[i] << " ";
    }
    cout << endl;
    cout << "K is number of times you want to rotate the array to the left" << endl;
    cout << "Enter K: ";
    cin >> K;
    for (int i = 0; i < K; i++) {
    int temp = arr[N-1];
    for (int j=N-1; j>0; j--) {
        arr[j] = arr[j - 1];
    }
    arr[0] = temp;
}
for (int i = 0; i < N; i++)
        cout << arr[i] << " ";
    return 0;
}
