#include<iostream>
using namespace std;
int main () {
      int N, i;
    cout << "N is the number of elements in Array" << endl;
    cout << "Enter N : ";
    cin >> N;
    int arr[N];
    cout << "Enter each elements of the Array : " << endl;;
    for(i=0; i<N; i++) {
       cin >> arr[i];
    }
    cout << "OUTPUT : "; 
    for(i=0; i<N; i++) {
       cout << arr[i] << " ";
    }
    cout << endl;
    cout << "Reversed Array is: ";
    int left=0, right=N-1;
   while (left < right) {
        swap(arr[left], arr[right]);
        left++;
        right--;
    }
    for (int i=0; i<N; i++) {
        cout << arr[i] << " ";
    }
    return 0;
}
