#include<iostream>
using namespace std;
int main() {
int target, i, j, N, found=0;
cout << "N is the number of element you want in the array" << endl;
cout << "Enter N: ";
cin >> N;
int arr[N];
cout << "Enter each elements of the Array : " << endl;;
for(i=0; i<N; i++) {
       cin >> arr[i];
 }
cout << "OUTPUT : "; 
for(i=0; i<N; i++) {
       cout << arr[i] << " ";
}
cout << endl;
cout << "Enter Target Sum : ";
cin >> target;
for(i=0; i<N; i++) {
   for(j=i+1; j<N; j++) {
       if(arr[i]+arr[j]==target) {
        cout << "Pair is " << arr[i] << ", " << arr[j] << endl;
        found++;
       }
    }
}
if(found==0)
   cout << "NO pair found" << endl;
}
